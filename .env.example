# Optional. Everything has a default, so the app runs without a .env file.
# Copy to .env (git-ignored) to change the defaults on your machine; per-machine overrides go in .env.local.

# Environment loaded by app.config.ts: production | preview (default: preview).
APP_ENV=preview

# Override the environment's API URL. EXPO_PUBLIC_* values are inlined into the JS bundle and visible
# to end users: never put secrets here.
# EXPO_PUBLIC_API_URL=http://localhost:3000

# EAS project id and account. Normally hardcoded in app.config.ts after `bunx eas-cli init`; these
# override it (useful in CI).
# EAS_PROJECT_ID=
# EAS_OWNER=
